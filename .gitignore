# ---------------------------------------------------------------- Python / uv
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.python-version.local
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ---------------------------------------------------------------- Node / web
node_modules/
apps/web/dist/
apps/web/*.tsbuildinfo
apps/web/.vite/

# ---------------------------------------------------------------- Secrets
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------- Donnees runtime
# Les donnees brutes (44 Mo) restent hors du depot, mais le lot du jury est
# un livrable : il est versionne, et consomme tel quel par le job et les e2e.
/data/*
!/data/seed/
!/data/seed/lot_20_factures.json
/models/
/backups/
/artifacts/

# ---------------------------------------------------------------- n8n
# Les workflows sont versionnes, les credentials contiennent le webhook Slack
# et la cle LLM : jamais commites.
#
# On ignore le CONTENU du dossier, pas le dossier lui-meme. Ecrire
# `apps/n8n/credentials/` suivi de `!.../README.md` ne fonctionne pas : Git ne
# peut pas re-inclure un fichier dont un dossier parent est deja exclu, la
# negation est silencieusement ignoree et le README restait non versionne --
# donc la doc de restauration des credentials n'arrivait jamais a l'equipe.
apps/n8n/credentials/*
!apps/n8n/credentials/README.md

# ---------------------------------------------------------------- Divers
.DS_Store
*.log
.idea/
.vscode/
local/

# ---------------------------------------------------------------- Tests front
# Artefacts Playwright : captures d'echec, traces, rapports. Le navigateur
# lui-meme est installe dans le cache utilisateur, pas dans le depot.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
