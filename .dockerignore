# Garde le contexte de build minimal et reproductible.
.git/
.github/
.gitignore
.dockerignore

# Secrets et donnees : jamais dans une image
.env
.env.*
!.env.example
# Les jeux de donnees bruts (CSV) ne doivent pas-enter dans une image.
# Seul le lot de jury est re-inclus : l'ecran professionnel doit pouvoir
# le charger en un clic, et il est deja versionne.
data/*
!data/seed/
data/seed/*
!data/seed/lot_20_factures.json
models/
backups/
artifacts/
apps/n8n/credentials/

# Fichiers de travail locaux
.venv/
venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Interface compilee localement (reconstruite dans l'image)
apps/web/node_modules/
apps/web/dist/

# Docs et tests d'integration : pas necessaires a l'execution
docs/
tests/
*.md