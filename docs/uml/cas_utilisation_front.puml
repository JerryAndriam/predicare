@startuml cas_utilisation_front
' =====================================================================
' PrediCare TPA - Diagramme de cas d'utilisation du front web
' Source lisible du diagramme cas_utilisation_front.svg
' Etat du code apps/web au 20/10/2026.
' Rendu : plantuml cas_utilisation_front.puml -tsvg
' =====================================================================

left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #E6F4F1
  BorderColor #0F766E
  FontColor #0E1A27
}
skinparam rectangle {
  BackgroundColor #F9FCFC
  BorderColor #0F766E
  FontColor #0B5C56
}

title PrediCare TPA — Cas d'utilisation de l'interface web (état au 20/10/2026)

' ---------------------------------------------------------------- acteurs
actor "Visiteur" as Visiteur
actor "Utilisateur authentifié" as Auth
actor "Assuré" as Assure
actor "Professionnel\nde santé" as Pro
actor "Gestionnaire" as Gest
actor "Administrateur" as Admin

actor "Agent RAG\n(LLM + pgvector + SQL)" as RAG
actor "Service d'inférence\n(XGBoost + SHAP)" as Inference

' Les quatre rôles héritent du socle commun.
Assure --|> Auth
Pro --|> Auth
Gest --|> Auth
Admin --|> Auth

' ---------------------------------------------------------------- socle
rectangle "Interface web PrediCare — cas réalisés" {

  usecase "C1 — S'authentifier" as C1
  usecase "C2 — Se déconnecter" as C2
  usecase "C3 — Consulter son espace d'accueil" as C3

  ' -------------------------------------------------------------- assuré
  usecase "UC1 — Consulter ses remboursements" as UC1
  usecase "UC2 — Interroger l'assistant RAG" as UC2
note right of UC2
  Interface livree, mais chaine RAG
  en erreur 500 au 20/10/2026 (G10).
end note
  usecase "UC2a — Rechercher dans les contrats" as UC2a
  usecase "UC2b — Lire l'historique de l'assuré" as UC2b

  ' -------------------------------------------------------------- professionnel
  usecase "UC3 — Déposer une facture" as UC3
  usecase "UC4 — Consulter la notation SHAP" as UC4
  usecase "UC5 — Déposer une ordonnance" as UC5
  usecase "UC6 — Suivre les dossiers déposés" as UC6

  ' -------------------------------------------------------------- gestionnaire
  usecase "UC7 — Consulter la file d'alertes" as UC7
  usecase "UC8 — Lire le détail SHAP" as UC8
  usecase "UC9 — Prendre une décision motivée" as UC9
  usecase "UC10 — Consulter l'historique des décisions" as UC10

  ' -------------------------------------------------------------- administrateur
  usecase "UC11 — Régler le seuil d'alerte" as UC11
  usecase "UC12 — Gérer le modèle et les versions" as UC12
  usecase "UC13 — Superviser la plateforme" as UC13
  usecase "UC13a — Consulter la santé et les secrets" as UC13a
  usecase "UC13b — Consulter le journal d'audit" as UC13b
  usecase "UC13c — Consulter les canaux de notification" as UC13c
  usecase "UC14 — Gérer les comptes" as UC14
}

' ---------------------------------------------------------------- écarts CDC
rectangle "Cas requis par le CDC, non exposés dans l'interface web" #line:red {

  usecase "G1 — Importer un lot de factures\n(Professionnel)" as G1 #FFE3E0
  usecase "G2 — Détecter les anomalies de prescription\n(Professionnel, Gestionnaire)" as G2 #FFE3E0
  usecase "G3 — Consulter le tableau de bord BI\n(Gestionnaire, Administrateur)" as G3 #FFE3E0
  usecase "G4 — Configurer canaux et secrets\n(Administrateur)" as G4 #FFE3E0
  usecase "G5 — Superviser métriques et dérive\n(Administrateur)" as G5 #FFE3E0
  usecase "G6 — Changer son mot de passe\n(Tous)" as G6 #FFE3E0
}

' ---------------------------------------------------------------- associations
Visiteur --> C1
Auth --> C2
Auth --> C3

Assure --> UC1
Assure --> UC2
UC2 .> UC2a : <<include>>
UC2 .> UC2b : <<include>>
UC2a --> RAG
UC2b --> RAG

Pro --> UC3
Pro --> UC5
Pro --> UC6
UC3 .> UC4 : <<include>>
UC4 --> Inference

Gest --> UC7
Gest --> UC10
UC8 .> UC7 : <<extend>>
UC9 .> UC8 : <<extend>>

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
UC13 .> UC13a : <<include>>
UC13 .> UC13b : <<include>>
UC13 .> UC13c : <<include>>

' ---------------------------------------------------------------- notes
note right of UC1
  Montants pris en charge / reste à charge,
  statut normalisé et badge de contrôle.
  Filtre assuré appliqué côté serveur.
end note

note right of UC3
  Référentiels /references, lignes d'actes,
  plafond 10 000 000 MGA, rejet 422 affiché
  avec le champ fautif.
end note

note right of UC9
  Commentaire obligatoire (>= 3 caractères).
  3 issues : valider la fraude, rejeter,
  demander une pièce.
end note

note right of UC12
  Charger / basculer / retour arrière sans
  redémarrage ; métriques de la version active.
end note

note bottom of G1
  Aucun import de fichier : le front ne sait
  déposer qu'une facture à la fois, via formulaire.
end note

legend right
  |= Symbole |= Sens |
  | <#E6F4F1> ellipse verte | Cas réalisé dans apps/web |
  | <#FFE3E0> ellipse rouge | Cas requis par le CDC, absent du front |
  | trait pointillé | <<include>> / <<extend>> |
  | acteur à droite | Acteur secondaire (service) |
endlegend

@enduml
