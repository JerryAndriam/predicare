# =============================================================================
# PrediCare TPA - modele de configuration
# -----------------------------------------------------------------------------
# 1. cp .env.example .env
# 2. make secrets   (regenere les secrets cryptographiques)
# 3. make up
#
# AUCUN FICHIER .ENV N'EST JAMAIS COMMITEE (.gitignore).
# Aucun secret n'est code en dur : tout passe par ici ou par l'ecran
# d'administration (Phase 6.5 / 9.6 du plan d'action).
# =============================================================================

# ------------------------------------------------------------------ PROJET
COMPOSE_PROJECT_NAME=predicare
TZ=Europe/Paris
LOG_LEVEL=INFO
# debug | info | warning | error
API_LOG_FORMAT=json

# ------------------------------------------------------------------ POSTGRES
# Base unique : metier + vecteurs + audit (contrainte du CDC, section 5)
#
# ATTENTION : ce mot de passe n'est applique que lors de la PREMIERE
# initialisation du volume. Le modifier dans .env apres un premier demarrage
# rend la base inaccessible (FATAL: password authentication failed).
# Pour changer de mot de passe apres coup :
#   1. make down
#   2. ALTER ROLE predicare WITH PASSWORD '<nouveau>' ;   (dans make shell-db)
#   3. mettre a jour POSTGRES_PASSWORD, PREDICARE_DB_URL et
#      PREDICARE_DB_RO_URL dans .env
# Perte totale des donnees de demonstration ? `make clean`.
POSTGRES_USER=predicare
POSTGRES_PASSWORD=CHANGER_MOI_POSTGRES
POSTGRES_DB=predicare
# PostgreSQL et Redis ne publient AUCUN port sur l'hote : le reseau `core`
# est `internal: true`, Docker ignore donc toute declaration `ports:`.
# Acces a la base depuis la machine : `make shell-db`.

# URL applicative (réseau interne Docker)
PREDICARE_DB_URL=postgresql+psycopg://predicare:CHANGER_MOI_POSTGRES@db:5432/predicare

# Compte en LECTURE SEULE reserve a l'agent RAG et a Superset.
# Le filtre sur l'assure connecte est applique COTE SERVEUR (jamais dans le prompt).
# Ce mot de passe cree le role PostgreSQL predicare_ro lors des migrations :
# il doit rester stable, sinon l'agent perd son acces en lecture.
PREDICARE_DB_RO_PASSWORD=CHANGER_MOI_DB_RO
PREDICARE_DB_RO_URL=postgresql+psycopg://predicare_ro:CHANGER_MOI_DB_RO@db:5432/predicare

# Bases annexes creees par le job de migration
N8N_DB_NAME=n8n
SUPERSET_DB_NAME=superset

# ------------------------------------------------------------------ SECRETS APP
# Generes par `make secrets`. Epingles : un secret qui change invalide les
# jetons JWT et rend le chiffrement de la table d'identites illisible.
APP_SECRET_KEY=CHANGER_MOI_APP
JWT_SECRET_KEY=CHANGER_MOI_JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Cle de chiffrement de la table d'identites (RGPD / CDC section 5).
# Format attendu : 32 octets en base64 (Fernet).
IDENTITY_ENCRYPTION_KEY=CHANGER_MOI_FERNET

# ------------------------------------------------------------------ REDIS
# Redis : cache applicatif interne, non expose (voir POSTGRES_PORT).
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------ PORTS
GATEWAY_PORT=8080
WEB_PORT=8081
API_CORE_PORT=8001
API_INFERENCE_PORT=8002
API_RAG_PORT=8003
N8N_PORT=5678
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MLFLOW_PORT=5000
SUPERSET_PORT=8088
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ------------------------------------------------------------------ METIER
# Seuil d'alerte : modifiable a chaud depuis l'ecran d'administration.
FRAUD_ALERT_THRESHOLD=0.8
# Rappel minimal vise (compromis precision/rappel a justifier au jury)
FRAUD_MIN_RECALL=0.90
CORS_ORIGINS=http://localhost:8080

# ------------------------------------------------------------------ LLM (API)
# Endpoint compatible OpenAI : OpenAI, Mistral, NVIDIA NIM, Gemini (via
# LiteLLM/proxy), ou tout autre fournisseur. LangChain lit ces 3 variables.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=CHANGER_MOI_LLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

# ------------------------------------------------------------------ EMBEDDINGS
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=CHANGER_MOI_LLM
EMBEDDING_MODEL=text-embedding-3-small
# Dimension pgvector. 1536 = OpenAI text-embedding-3-small.
# 3072 = text-embedding-3-large. 1024 = nomic/nvidia. 768 = all-MiniLM.
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------ RAG / agent
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.72
RAG_MAX_AGENT_STEPS=8
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400

# ------------------------------------------------------------------ MODELE ML
MODEL_DIR=/models
MODEL_ACTIVE_VERSION=1
# Laissez COMMENTE tant qu'aucune version candidate n'est en attente de bascule.
# MODEL_CANDIDATE_VERSION=
# Fenetre glissante de suivi de derive (Phase 3.4)
DRIFT_WINDOW_DAYS=30
DRIFT_KS_THRESHOLD=0.1

# ------------------------------------------------------------------ n8n
# AUTHENTIFICATION : il n'y a PAS de mot de passe n8n dans ce fichier.
#
# n8n a supprime l'authentification basique en version 1.x : les variables
# N8N_BASIC_AUTH_* ne sont plus lues. Le compte proprietaire se cree au
# premier lancement de http://localhost:5678, avec l'email saisi par le
# visiteur. Chaque machine a donc son propre compte.
#
# `make n8n-compte` affiche l'etat du compte et la procedure.
# Le partage des workflows entre machines passe par Git :
# `make n8n-export` puis `make n8n-import`.
#
# N8N_ENCRYPTION_KEY DOIT RESTE STABLE : elle permet de dechiffrer un export
# de credentials restaure sur une machine vierge. Ne jamais la regenerer
# apres avoir cree des credentials dans l'interface.
N8N_ENCRYPTION_KEY=CHANGER_MOI_N8N
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_DIAGNOSTICS_ENABLED=false
# Cle d'API publique n8n (Settings > n8n API). OPTIONNELLE : elle permet a
# `make n8n-import` de REMPLACER un workflow deja present et de l'activer.
# Sans elle, les scripts passent par la CLI n8n, qui n'expose pas la
# suppression : un workflow deja importe est alors conserve, pas remplace.
N8N_API_KEY=CHANGER_MOI_N8N_API_KEY
# A definir dans l'interface n8n (credentials), pas ici.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_ID=
# Montant au-dela duquel le workflow n8n demande une prediction. Sert de
# garde-fou : inutile de scorer une facture de quelques euros.
N8N_PLAFOND_MONTANT=1000
SMTP_FROM=alertes@predicare.local

# Compte en lecture seule du tableau de bord BI, distinct de celui de
# l'agent RAG : deux briques, deux identites.
SUPERSET_DB_RO_PASSWORD=CHANGER_MOI_SUPERSET_RO

# ------------------------------------------------------------------ MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT=http://minio:9000
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://predicare-artifacts/mlflow

# ------------------------------------------------------------------ SUPERSET
SUPERSET_SECRET_KEY=CHANGER_MOI_SUPERSET_KEY
# Cle de chiffrement des mots de passe de connexion stockes par Superset.
# Elle est DISTINCTE de SUPERSET_SECRET_KEY : deriver l'une de l'autre
# relierait la session et le stockage des secrets.
SUPERSET_FERNET_KEY=CHANGER_MOI_SUPERSET_FERNET
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=CHANGER_MOI_SUPERSET_PASSWORD
SUPERSET_LOAD_EXAMPLES=no

# ------------------------------------------------------------------ GRAFANA
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGER_MOI_GRAFANA