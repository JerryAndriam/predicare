# =============================================================================
# PrediCare TPA - modele de configuration
# -----------------------------------------------------------------------------
# 1. cp .env.example .env
# 2. make secrets   (regenere les secrets cryptographiques)
# 3. make up
#
# AUCUN FICHIER .ENV N'EST JAMAIS COMMITEE (.gitignore).
# Aucun secret n'est code en dur : tout passe par ici ou par l'ecran
# d'administration (Phase 6.5 / 9.6 du plan d'action).
# =============================================================================

# ------------------------------------------------------------------ PROJET
COMPOSE_PROJECT_NAME=predicare
TZ=Europe/Paris
LOG_LEVEL=INFO
# debug | info | warning | error
API_LOG_FORMAT=json

# ------------------------------------------------------------------ POSTGRES
# Base unique : metier + vecteurs + audit (contrainte du CDC, section 5)
#
# ATTENTION : ce mot de passe n'est applique que lors de la PREMIERE
# initialisation du volume. Le modifier dans .env apres un premier demarrage
# rend la base inaccessible (FATAL: password authentication failed).
# Pour changer de mot de passe apres coup :
#   1. make down
#   2. ALTER ROLE predicare WITH PASSWORD '<nouveau>' ;   (dans make shell-db)
#   3. mettre a jour POSTGRES_PASSWORD, PREDICARE_DB_URL et
#      PREDICARE_DB_RO_URL dans .env
# Perte totale des donnees de demonstration ? `make clean`.
POSTGRES_USER=predicare
POSTGRES_PASSWORD=CHANGER_MOI_POSTGRES
POSTGRES_DB=predicare
# PostgreSQL et Redis ne publient AUCUN port sur l'hote : le reseau `core`
# est `internal: true`, Docker ignore donc toute declaration `ports:`.
# Acces a la base depuis la machine : `make shell-db`.

# URL applicative (réseau interne Docker)
PREDICARE_DB_URL=postgresql+psycopg://predicare:CHANGER_MOI_POSTGRES@db:5432/predicare

# Compte en LECTURE SEULE reserve a l'agent RAG et a Superset.
# Le filtre sur l'assure connecte est applique COTE SERVEUR (jamais dans le prompt).
# Ce mot de passe cree le role PostgreSQL predicare_ro lors des migrations :
# il doit rester stable, sinon l'agent perd son acces en lecture.
PREDICARE_DB_RO_PASSWORD=CHANGER_MOI_DB_RO
PREDICARE_DB_RO_URL=postgresql+psycopg://predicare_ro:CHANGER_MOI_DB_RO@db:5432/predicare

# Bases annexes creees par le job de migration
N8N_DB_NAME=n8n
SUPERSET_DB_NAME=superset

# ------------------------------------------------------------------ SECRETS APP
# Generes par `make secrets`. Epingles : un secret qui change invalide les
# jetons JWT et rend le chiffrement de la table d'identites illisible.
APP_SECRET_KEY=CHANGER_MOI_APP
JWT_SECRET_KEY=CHANGER_MOI_JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Cle de chiffrement de la table d'identites (RGPD / CDC section 5).
# Format attendu : 32 octets en base64 (Fernet).
IDENTITY_ENCRYPTION_KEY=CHANGER_MOI_FERNET

# ------------------------------------------------------------------ COMPTES DEMO
# Mot de passe commun aux quatre comptes de demonstration (`make comptes`).
# Laisser vide pour en generer un aleatoire, affiche UNE seule fois.
# `make lot-jury` et les tests e2e lisent la meme variable.
# DEMO_PASSWORD=CHANGER_MOI_DEMO

# ------------------------------------------------------------------ REDIS
# Redis : cache applicatif interne, non expose (voir POSTGRES_PORT).
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------ PORTS
GATEWAY_PORT=8080
WEB_PORT=8081
API_CORE_PORT=8001
API_INFERENCE_PORT=8002
API_RAG_PORT=8003
N8N_PORT=5678
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MLFLOW_PORT=5000
SUPERSET_PORT=8088
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# URL du tableau de bord Superset affiche aux gestionnaires et
# administrateurs. Elle est inlined par Vite au build : changez-la puis
# reconstruisez l'image web.
VITE_SUPERSET_URL=http://localhost:8088

# ------------------------------------------------------------------ METIER
# Seuil d'alerte du modele de fraude, modifiable a chaud depuis l'ecran
# d'administration (`make threshold VALEUR=...`).
#
# LAISSER VIDE est la valeur recommandee : la plateforme adopte alors le seuil
# CALCULE par `make train` (inscrit dans `models/<version>/metadata.json`), et
# le publie en base pour que la file du gestionnaire et le tableau de bord
# affichent le meme chiffre que le service d'inference. C'est ce seuil qui
# minimise le cout metier total sous contrainte de rappel >= FRAUD_MIN_RECALL ;
# il vaut 0.2876 (voir `reports/modele_v2.md`). Avec
# 8,7 % de fraude dans la population, le seuil historique de 0.8 laissait
# passer une part importante des vraies fraudes.
#
# Une valeur renseignee ici FIXE le seuil : elle prime sur celle du modele et
# sur celle enregistree par l'administration.
FRAUD_ALERT_THRESHOLD=
# Rappel minimal vise par le choix du seuil (compromis precision/rappel a
# justifier au jury). Contrainte du plan d'action, Module 2.
FRAUD_MIN_RECALL=0.90
CORS_ORIGINS=http://localhost:8080

# ------------------------------------------------------------------ LLM (API)
# Endpoint compatible OpenAI : OpenAI, Mistral, NVIDIA NIM, Gemini (via
# LiteLLM/proxy), ou tout autre fournisseur. LangChain lit ces 3 variables.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=CHANGER_MOI_LLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

# ------------------------------------------------------------------ EMBEDDINGS
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=CHANGER_MOI_LLM
EMBEDDING_MODEL=text-embedding-3-small
# Dimension pgvector. 1536 = OpenAI text-embedding-3-small.
# 3072 = text-embedding-3-large. 1024 = nomic/nvidia. 768 = all-MiniLM.
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------ RAG / agent
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.55
RAG_MAX_AGENT_STEPS=8
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400

# Memoire de session (Phase C). Les tours sont stockes dans Redis avec ce
# TTL ; les reponses contiennent des donnees personnelles, Redis doit rester
# sur le reseau interne `core`.
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=6
# Nombre maximal de sessions gardees par le repli memoire si Redis est absent.
SESSION_MAX_SESSIONS=1000

# FinOps (Phase F) : tarifs LLM en USD par million de tokens et taux
# indicatif USD -> EUR. A ajuster sur la grille reelle du fournisseur.
LLM_INPUT_COST_PER_MILLION_USD=0.15
LLM_OUTPUT_COST_PER_MILLION_USD=0.60
TAUX_USD_EUR=0.92

# ------------------------------------------------------------------ MODELE ML
MODEL_DIR=/models
MODEL_ACTIVE_VERSION=2
# Laissez COMMENTE tant qu'aucune version candidate n'est en attente de bascule.
# MODEL_CANDIDATE_VERSION=
# Fenetre glissante de suivi de derive (Phase 3.4)
DRIFT_WINDOW_DAYS=30
DRIFT_KS_THRESHOLD=0.1

# ------------------------------------------------------------------ n8n
# AUTHENTIFICATION : il n'y a PAS de mot de passe n8n dans ce fichier.
#
# n8n a supprime l'authentification basique en version 1.x : les variables
# N8N_BASIC_AUTH_* ne sont plus lues. Le compte proprietaire se cree au
# premier lancement de http://localhost:5678, avec l'email saisi par le
# visiteur. Chaque machine a donc son propre compte.
#
# `make n8n-compte` affiche l'etat du compte et la procedure.
# Le partage des workflows entre machines passe par Git :
# `make n8n-export` puis `make n8n-import`.
#
# N8N_ENCRYPTION_KEY DOIT RESTE STABLE : elle permet de dechiffrer un export
# de credentials restaure sur une machine vierge. Ne jamais la regenerer
# apres avoir cree des credentials dans l'interface.
N8N_ENCRYPTION_KEY=CHANGER_MOI_N8N
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_DIAGNOSTICS_ENABLED=false
# Cle d'API publique n8n (Settings > n8n API). OPTIONNELLE : elle permet a
# `make n8n-import` de passer par l'API (publication a chaud). Sans elle, la
# CLI met a jour les workflows existants sur place (upsert sur leur `id`) puis
# redemarre n8n pour enregistrer les webhooks.
N8N_API_KEY=CHANGER_MOI_N8N_API_KEY
# Webhook n8n appele par api-inference APRES une bascule de modele (Phase 8.2).
# Laisser vide desactive la notification ; la bascule reste fonctionnelle.
#
# En conteneur, l'adresse est le nom du service Compose, PAS localhost :
#   N8N_BASCULE_WEBHOOK_URL=http://n8n:5678/webhook/bascule-modele
# Le workflow `PK-Bascule-Modele` doit etre importe ET actif, sinon n8n
# repond 404 : api-inference journalise `modele.bascule_non_notifiee` et
# continue (une notification perdue ne defait jamais une bascule).
N8N_BASCULE_WEBHOOK_URL=
# Webhook ENTRANT Slack (Slack > Apps > Incoming Webhooks). C'est la voie
# utilisee par le workflow : elle ne demande aucun scope OAuth et ne peut
# pas etre bloquee par une application mal configuree. Le salon est celui
# choisi a la creation du webhook, d'ou l'absence de SLACK_CHANNEL_ID.
#
# Pourquoi pas une credential n8n `slackApi` : elle exige un jeton de bot
# avec les scopes `chat:write` (+ `channels:read` pour lister les salons).
# Sans eux, Slack repond « missing required Oauth Scopes » et rien ne part.
SLACK_WEBHOOK_URL=
# Seuil de NOTIFICATION du workflow n8n, distinct du seuil de detection.
#
#   FRAUD_ALERT_THRESHOLD (voir plus haut) = seuil de DETECTION
#       Ce que le modele considere comme suspect : la facture entre dans la
#       file du gestionnaire et est ecrite dans ml.prediction.
#
#   SEUIL_NOTIFICATION_SLACK = seuil de NOTIFICATION
#       Ce qui declenche une alerte Slack et un e-mail. Le CDC l'exige
#       litteralement (Flux 1 : « Si Score > 0.8 -> Notification Slack »).
#       Pour la chaine web, api-core envoie deja `seuil_notification` dans la
#       charge et le workflow le prefere : cette variable n'est que le repli
#       de `PK-Alerte-Fraude` (appel direct avec une facture brute).
#
# Les deux seuils sont deliberement distincts : une alerte Slack est une
# INTERRUPTION HUMAINE, reservee aux cas tres nets, alors que la file de
# travail doit voir toutes les detections. A 0.8, on ne notifie qu'une
# fraction des detections sans en perdre aucune : les autres restent
# consultables au tableau de bord.
SEUIL_NOTIFICATION_SLACK=0.8
# Adresse du gestionnaire qui recoit l'alerte par e-mail. En developpement,
# le bac a sable Mailpit (profil `make up-email`) affiche tout le trafic.
SMTP_GESTIONNAIRE=gestionnaire@predicare.local
SMTP_FROM=alertes@predicare.local
# API HTTP de la boite de reception (Mailpit en developpement). Elle sert au
# test d'envoi du canal e-mail depuis l'ecran d'administration.
SMTP_API_URL=http://mailpit:8025/api/v1/send

# ------------------------------------------------------------------ ALERTE (Flux 1)
# Webhook n8n appele par api-core quand une facture du PARCOURS WEB franchit
# le seuil de NOTIFICATION. C'est ce qui declenche reellement l'alerte Slack
# au gestionnaire, avec le rapport d'explicabilite.
#
# L'adresse est celle du workflow `PK-Alerte-Fraude-Interne`
# (chemin `alerte-fraude-interne`). Ne PAS pointer vers `alerte-fraude` :
# ce dernier workflow RE-SCORE la charge recue comme une facture brute. Or
# api-core lui envoie deja un score et un rapport SHAP, pas une facture :
# la validation repondrait 422, n8n 502, et aucune notification ne partirait.
#
# LAISSER VIDE desactive l'alerte : le depot continue de fonctionner, seule la
# notification est omise.
#
# Le workflow interne ne RE-SCORE PAS : il recoit la charge NOTIFIEE par
# api-core (score, seuil applique, seuil de notification, rapport SHAP). La
# notation appartient a l'API, la notification au workflow : une seule chaine,
# un seul seuil. `PK-Alerte-Fraude` reste le chemin autonome pour un appelant
# externe qui POSTE une facture brute.
N8N_ALERTE_WEBHOOK_URL=http://n8n:5678/webhook/alerte-fraude-interne
# Seuil de NOTIFICATION applique par api-core AVANT d'appeler n8n. api-core
# l'envoie dans la charge (`seuil_notification`) : le workflow n8n n'a donc
# plus a relire une variable d'environnement pour decider.
#
# Hierarchie de la source unique, dans cet ordre :
#   1. `audit.parametre` cle `seuil_notification` (reglage d'exploitation,
#      relu a chaque alerte, sans redemarrage) ;
#   2. cette variable N8N_SEUIL_NOTIFICATION (configuration de la machine) ;
#   3. 0.8 (valeur litterale du CDC).
# Le resultat ne descend jamais sous le seuil de DETECTION effectif
# (`FRAUD_ALERT_THRESHOLD` / `audit.parametre.seuil_alerte`) : on ne notifie
# pas une facture que le modele n'a pas retenue.
#
# SEUIL_NOTIFICATION_SLACK reste le repli du workflow pour un appel direct
# sans `seuil_notification` dans le corps.
N8N_SEUIL_NOTIFICATION=0.8

# Compte en lecture seule du tableau de bord BI, distinct de celui de
# l'agent RAG : deux briques, deux identites.
SUPERSET_DB_RO_PASSWORD=CHANGER_MOI_SUPERSET_RO

# ------------------------------------------------------------------ MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT=http://minio:9000
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://predicare-artifacts/mlflow

# ------------------------------------------------------------------ SUPERSET
SUPERSET_SECRET_KEY=CHANGER_MOI_SUPERSET_KEY
# Cle de chiffrement des mots de passe de connexion stockes par Superset.
# Elle est DISTINCTE de SUPERSET_SECRET_KEY : deriver l'une de l'autre
# relierait la session et le stockage des secrets.
SUPERSET_FERNET_KEY=CHANGER_MOI_SUPERSET_FERNET
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=CHANGER_MOI_SUPERSET_PASSWORD
# Compte de demonstration du tableau de bord, en lecture seule (role metier cree par `make bi-compte-demo`).
SUPERSET_DEMO_PASSWORD=CHANGER_MOI_MOT_DE_PASSE_DEMO
SUPERSET_LOAD_EXAMPLES=no
# Embedding du tableau dans l'application : role invite, guest token et
# compte de service. Le compte de service est Admin car Superset reserve
# `can_grant_guest_token` aux administrateurs.
SUPERSET_GUEST_ROLE=PrediCare BI (invité)
SUPERSET_GUEST_TOKEN_SECRET=CHANGER_MOI_GUEST_TOKEN
SUPERSET_PUBLIC_URL=http://localhost:8080
SUPERSET_EMBED_ALLOWED_DOMAINS=http://localhost:8080,http://127.0.0.1:8080
SUPERSET_BI_SERVICE_USERNAME=predicare-bi
SUPERSET_BI_SERVICE_PASSWORD=CHANGER_MOI_BI_SERVICE
SUPERSET_DASHBOARD_SLUG=pilotage-mensuel

# ------------------------------------------------------------------ GRAFANA
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGER_MOI_GRAFANA